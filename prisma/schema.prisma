model ProductCategory {
  id   String @id @default(cuid())
  name String @unique

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  products Product[]
}

model Product {
  id          String   @id @default(cuid())
  name        String
  category_id String
  region_id   String
  price       Int
  link        String?
  is_favorite Boolean? @default(false)
  is_archived Boolean? @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  category ProductCategory @relation(fields: [category_id], references: [id])
  region   Region          @relation(fields: [region_id], references: [id])

  tea_characteristics TeaCharacteristics?
  tea_note            TeaNote?
}

model TeaCharacteristics {
  id         String  @id @default(cuid())
  product_id String  @unique
  type       String
  season     String?
  year       Int?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  product Product @relation(fields: [product_id], references: [id])
}

model TeaNote {
  id             String   @id @default(cuid())
  product_id     String   @unique
  appearance     String
  dry_leaf_aroma String[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  product            Product           @relation(fields: [product_id], references: [id])
  infusion_tea_notes InfusionTeaNote[]
}

model InfusionTeaNote {
  id                String   @id @default(cuid())
  tea_note_id       String   @unique
  brewing_method_id String
  infusion          String
  color             String
  flavor            String[]
  extractivity      String
  body              String
  taste             String[]
  balance           String
  bouquet           String
  aftertaste        String
  rating            Int

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tea_note       TeaNote       @relation(fields: [tea_note_id], references: [id])
  brewing_method BrewingMethod @relation(fields: [brewing_method_id], references: [id])
}

model BrewingMethod {
  id                String  @id @default(cuid())
  teaware           String
  tea_weight        Int
  water_volume      Int
  water_temperature Int
  brewing_time      Int?
  is_steeping       Boolean

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  infusion_tea_note InfusionTeaNote[]
}
